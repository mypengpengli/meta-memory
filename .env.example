# Run `sh docker/bootstrap.sh` to create .env, generate the token, detect the
# Linux host uid/gid, and create persistent directories before Compose starts.
COMPOSE_PROJECT_NAME=meta-memory
META_MEMORY_IMAGE=meta-memory:local
PYTHON_IMAGE=python:3.12-slim-bookworm

# The same high-entropy value is configured on the remote Agent as
# META_MEMORY_TOKEN. It is never written into agents.json.
META_MEMORY_TOKEN=

# First hosted Agent binding. Edit /config/agents.json later to add more Agents.
META_MEMORY_BOOTSTRAP_AGENT_ID=local-codex
META_MEMORY_BOOTSTRAP_WORKSPACE_ID=personal-workspace
META_MEMORY_BOOTSTRAP_SUBJECT_ID=person:user
# Comma-separated audience/channel ids; blank is allowed for private memory only.
META_MEMORY_BOOTSTRAP_AUDIENCE_IDS=

META_MEMORY_PROFILE_NAME=User
TZ=Asia/Shanghai

# Host paths are deliberately visible so backups and agents.json are easy to manage.
META_MEMORY_DATA_DIR=./runtime/data
META_MEMORY_CONFIG_DIR=./runtime/config
META_MEMORY_BACKUP_DIR_HOST=./runtime/backups

# The container starts as root only to repair bind-mount ownership, then drops
# privileges. bootstrap.sh replaces these with the Linux host uid/gid; these
# defaults are used by root operators and Docker Desktop.
META_MEMORY_UID=10001
META_MEMORY_GID=10001

# Bind the raw API to loopback. Enable the `https` Compose profile for Caddy.
META_MEMORY_BIND_ADDRESS=127.0.0.1
META_MEMORY_PORT=8765
META_MEMORY_MAX_ASSET_MB=64
META_MEMORY_ASSET_CHUNK_MB=2
META_MEMORY_HTTP_SHUTDOWN_TIMEOUT=20

# One serial worker performs all three schedules; values are in seconds.
META_MEMORY_HEARTBEAT_INTERVAL_SECONDS=600
META_MEMORY_DREAM_TIME=23:30
META_MEMORY_DREAM_RETRY_SECONDS=3600
META_MEMORY_BACKUP_INTERVAL_SECONDS=86400
META_MEMORY_BACKUP_RETRY_SECONDS=3600
META_MEMORY_BACKUP_RETENTION_DAYS=30
META_MEMORY_BACKUP_RETENTION_COUNT=14
META_MEMORY_WORKER_POLL_SECONDS=30

# Source upgrades refresh the base image by default. Set false only when the
# pinned base image is already cached and the registry is temporarily offline.
META_MEMORY_UPGRADE_PULL_BASE=true

# Required only for: docker compose --profile https up -d
MEMORY_DOMAIN=
MAX_REQUEST_BODY=70MB
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
